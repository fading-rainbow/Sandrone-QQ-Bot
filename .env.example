# QQ 机器人开放平台：机器人开发设置页
QQ_APP_ID=
QQ_APP_SECRET=

# OpenAI 或 OpenAI 兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_API_MODE=responses

# 生图通道独立于聊天；留空时复用 OPENAI_API_KEY / OPENAI_BASE_URL。
# 中转必须实际支持 2.6 Sunburst 的生成与编辑端点；仅模型目录可见不代表可用。
IMAGE_API_KEY=
IMAGE_BASE_URL=

# 生成参数
REASONING_EFFORT=high
MAX_OUTPUT_TOKENS=1400
HISTORY_MESSAGES=30
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_BATCH_MESSAGES=40
PROFILE_TRIGGER_MESSAGES=8
WEB_SEARCH_ENABLED=true
WEB_SEARCH_CACHE_SECONDS=1800
WEB_SEARCH_USER_COOLDOWN_SECONDS=30
WEB_SEARCH_GROUP_COOLDOWN_SECONDS=10
DATABASE_PATH=./data/sandrone.db
LOG_LEVEL=INFO
IMAGE_COOLDOWN_SECONDS=180
GENERATED_IMAGE_DIR=./data/generated
SANDRONE_REFERENCE_IMAGES=./assets/characters/sandrone/face-reference.jpg,./assets/characters/sandrone/outfit-reference.jpg

# 机器人的基础性格，可直接改成你喜欢的设定
# 留空时使用代码内置的桑多涅人设；只有需要完全覆盖时再填写
BOT_SYSTEM_PROMPT=
BOT_OWNER_IDS=
ALLOWED_GROUP_IDS=
